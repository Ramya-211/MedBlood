DB_PORT=3306
DB_NAME=medblood_db
DB_USER=medblood_app
DB_PASSWORD=ramya1410

--- MySQL admin account, used ONLY by init_db.py ---

DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=ramya1410

